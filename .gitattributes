# Normalise line endings. Source files stay LF in the repository regardless of
# the checkout platform — the wp.org SVN mirror and PHPCS both expect LF.
* text=auto eol=lf

*.php   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.py    text eol=lf

# Binary — never touch.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.mo    binary
*.zip   binary
